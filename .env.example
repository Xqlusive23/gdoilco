# Copy this file to .env and fill it in. Never commit .env.

# ---- Server (server/index.js) ----
PORT=4000
# Required. 64 hex characters used to encrypt SSNs and ID images at rest.
# Create one with:  npm run keygen
# Keep a safe backup of it. Without this key the stored data cannot be read.
SSN_ENCRYPTION_KEY=
# Where applications and encrypted ID files are saved.
DATA_DIR=./server/data
# ---- Email (confirmation and approval emails) ----
# Leave SMTP_HOST empty while developing: emails are then saved as web pages in server/data/outbox so you can open and see them.
# For real sending, fill these in with the details from your email provider (Gmail, Outlook, Brevo, SendGrid, Mailgun, Amazon SES...).
SMTP_HOST=
SMTP_PORT=587
# true for port 465, false for port 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The name and address applicants see. Use an address on a domain you own and have set up with your email provider.
MAIL_FROM="GDoil Company <no-reply@gdoilcompany.online>"
MAIL_REPLY_TO=
# The public address of the website, for the buttons in emails, for example https://www.gdoilcompany.online
PUBLIC_URL=

# Hosts without a terminal (Railway, Render): create the admin login from these on first start, then delete ADMIN_PASSWORD.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to 1 when the server runs behind a proxy or host (Render, Railway, Nginx...). Leave empty on your own computer.
TRUST_PROXY=
# Only needed when the website is served from a different domain than the server, e.g. https://www.gdoilcompany.online
ALLOWED_ORIGIN=

# ---- Website (Vite) ----
# Smartsupp live chat. Paste the key from Smartsupp (Settings > Channels > Live chat > Installation). Leave empty for no chat.
VITE_SMARTSUPP_KEY=
# Leave empty in development: Vite forwards /api to the server above.
# In production set it to the https address of the server if it is on another domain.
VITE_API_URL=
